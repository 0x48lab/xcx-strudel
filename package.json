{
  "name": "xcx-strudel",
  "version": "0.4.0",
  "description": "Strudel pattern music for Xcratch",
  "extensionId": "strudel",
  "scripts": {
    "setup-dev": "node ./scripts/setup-dev.mjs",
    "build": "rollup -c ./scripts/rollup.config.mjs",
    "watch": "rollup -c ./scripts/rollup.config.mjs --watch",
    "test": "vitest run",
    "version": "node ./scripts/version-build.mjs && git add dist",
    "demo": "node ./scripts/make-demo.mjs && node ./scripts/make-samples.mjs && node ./scripts/make-demo.mjs --en && node ./scripts/make-samples.mjs --en",
    "tutorial": "node ./scripts/make-tutorial.mjs && node ./scripts/make-tutorial.mjs --en",
    "tutorial:shots": "node ./scripts/shoot-tutorial.mjs && node ./scripts/shoot-tutorial.mjs --en && node ./scripts/stamp-images.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@babel/runtime": "^7.28.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "6.0.2",
    "@strudel/transpiler": "1.2.6",
    "babel-jest": "^30.0.5",
    "core-js": "^3.44.0",
    "eslint": "^8.57.1",
    "eslint-config-scratch": "^9.0.9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "fs-extra": "^11.3.0",
    "jest": "^30.0.5",
    "jszip": "3.10.1",
    "playwright-core": "^1.57.0",
    "rollup": "^4.46.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "superdough": "1.3.0"
  },
  "license": "AGPL-3.0-or-later"
}
